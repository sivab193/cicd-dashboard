# GitHub OAuth App credentials — create one at
# https://github.com/settings/developers
# Authorization callback URL:
#   local dev:  http://localhost:3000/api/auth/callback/github
#   production: https://cicd.siv19.dev/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# NextAuth session secret — generate with: npx auth secret
AUTH_SECRET=

# Canonical URL of the deployment (used for callback URLs).
# local dev: http://localhost:3000
AUTH_URL=https://cicd.siv19.dev

# Only this GitHub username is allowed to sign in.
ALLOWED_GITHUB_LOGIN=
