DEMO_MODE=true
APP_URL=http://127.0.0.1:5173
DATABASE_URL=postgresql+psycopg://cicd:change-me@postgres:5432/cicd
REDIS_URL=redis://redis:6379/0
SESSION_SECRET=generate-a-long-random-value
MASTER_ENCRYPTION_KEY=generate-with-python-cryptography-fernet

# Login and repository discovery
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_USERS={"your-github-login":"owner"}
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=

# Deployment providers
VERCEL_TOKEN=
HEALTH_ALLOWED_HOSTS=

# Optional notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cicd@example.com
TELEGRAM_BOT_TOKEN=
